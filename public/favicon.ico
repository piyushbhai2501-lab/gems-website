<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <rect width="64" height="64" rx="14" fill="#07261D"/>
  <rect x="2" y="2" width="60" height="60" rx="12" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-opacity="0.4"/>
  <!-- Faceted Emerald/Opal cut gem shape -->
  <polygon points="32,10 50,22 50,42 32,54 14,42 14,22" fill="#0B3D2E" stroke="#D4AF37" stroke-width="2"/>
  <polygon points="32,18 44,26 44,38 32,46 20,38 20,26" fill="none" stroke="#F4E297" stroke-width="1.2" stroke-dasharray="2 1"/>
  <!-- Gemstone table and crown facet lines -->
  <line x1="32" y1="10" x2="32" y2="18" stroke="#D4AF37" stroke-width="1.5"/>
  <line x1="50" y1="22" x2="44" y2="26" stroke="#D4AF37" stroke-width="1.5"/>
  <line x1="50" y1="42" x2="44" y2="38" stroke="#D4AF37" stroke-width="1.5"/>
  <line x1="32" y1="54" x2="32" y2="46" stroke="#D4AF37" stroke-width="1.5"/>
  <line x1="14" y1="42" x2="20" y2="38" stroke="#D4AF37" stroke-width="1.5"/>
  <line x1="14" y1="22" x2="20" y2="26" stroke="#D4AF37" stroke-width="1.5"/>
  <!-- Inner brilliant sparkle -->
  <circle cx="32" cy="32" r="3" fill="#FAF6EE"/>
</svg>
